{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Image Preprocessing Pipeline — Disease Detector (Model 2)\n",
        "\n",
        "This notebook prepares image data for the disease detection CNN:\n",
        "\n",
        "- Reads downloaded PlantVillage + Rice disease image folders\n",
        "- Filters/renames classes to Kerala-priority labels\n",
        "- Splits into **train / val / test (80/10/10)**\n",
        "- Normalizes file structure for the training notebook:\n",
        "\n",
        "```\n",
        "DATA_PATH/processed/disease_images/\n",
        "  train/<class_name>/*.jpg\n",
        "  val/<class_name>/*.jpg\n",
        "  test/<class_name>/*.jpg\n",
        "```\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "!pip -q install tqdm\n",
        "\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "DATA_PATH = '/content/drive/MyDrive/krishi_mitra_data/'\n",
        "\n+        "import os\n",
        "from pathlib import Path\n",
        "os.makedirs(DATA_PATH, exist_ok=True)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1) Configure raw and processed paths\n",
        "\n",
        "Assumptions:\n",
        "- You already ran `download_datasets_colab.ipynb`.\n",
        "- PlantVillage + Rice datasets are unzipped under `DATA_PATH/raw/unzipped/`.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from pathlib import Path\n",
        "\n",
        "base_raw = Path(DATA_PATH) / 'raw' / 'unzipped'\n",
        "base_proc = Path(DATA_PATH) / 'processed' / 'disease_images'\n",
        "base_proc.mkdir(parents=True, exist_ok=True)\n",
        "base_raw, base_proc"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2) Map source folders → unified class names\n",
        "\n",
        "Edit this mapping to match your actual folder names from PlantVillage/Rice datasets.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import shutil\n",
        "from tqdm import tqdm\n",
        "\n",
        "# Example mapping; adjust folder names on the left to the real ones you see in base_raw\n",
        "CLASS_MAP = {\n",
        "    # Rice\n",
        "    'Rice_Leaf_Blast': 'Rice_Leaf_Blast',\n",
        "    'Rice_Brown_Spot': 'Rice_Brown_Spot',\n",
        "    'Rice_Bacterial_Leaf_Blight': 'Rice_Bacterial_Leaf_Blight',\n",
        "    'Rice_Sheath_Blight': 'Rice_Sheath_Blight',\n",
        "    'Rice_Healthy': 'Rice_Healthy',\n",
        "    # Banana (example names; change as needed)\n",
        "    'Banana_Sigatoka': 'Banana_Sigatoka',\n",
        "    'Banana_Panama_Wilt': 'Banana_Panama_Wilt',\n",
        "    'Banana_Bract_Mosaic_Virus': 'Banana_Bract_Mosaic_Virus',\n",
        "    'Banana_Healthy': 'Banana_Healthy',\n",
        "    # Coconut, Pepper etc.\n",
        "    # ... add mappings when you curate folders ...\n",
        "}\n",
        "\n",
        "CLASS_MAP"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3) Collect image file paths and build a dataframe\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from pathlib import Path\n",
        "\n",
        "rows = []\n",
        "for src_name, unified in CLASS_MAP.items():\n",
        "    src_dir = list(base_raw.rglob(src_name))\n",
        "    if not src_dir:\n",
        "        print('WARNING: source folder not found for', src_name)\n",
        "        continue\n",
        "    src_dir = src_dir[0]\n",
        "    for img_path in src_dir.rglob('*'):\n",
        "        if img_path.suffix.lower() in ['.jpg', '.jpeg', '.png']:\n",
        "            rows.append({'path': img_path, 'class': unified})\n",
        "\n",
        "len(rows)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import pandas as pd\n",
        "\n",
        "df = pd.DataFrame(rows)\n",
        "df['class'].value_counts()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4) Train/val/test split (80/10/10 per class) and copy files\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "train_root = base_proc / 'train'\n",
        "val_root = base_proc / 'val'\n",
        "test_root = base_proc / 'test'\n",
        "for d in [train_root, val_root, test_root]:\n",
        "    d.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "for cls, group in df.groupby('class'):\n",
        "    paths = group['path'].tolist()\n",
        "    train_paths, temp_paths = train_test_split(paths, test_size=0.2, random_state=42)\n",
        "    val_paths, test_paths = train_test_split(temp_paths, test_size=0.5, random_state=42)\n",
        "\n",
        "    for split_name, split_paths, split_root in [\n",
        "        ('train', train_paths, train_root),\n",
        "        ('val', val_paths, val_root),\n",
        "        ('test', test_paths, test_root),\n",
        "    ]:\n",
        "        out_dir = split_root / cls\n",
        "        out_dir.mkdir(parents=True, exist_ok=True)\n",
        "        for src in tqdm(split_paths, desc=f'{cls} → {split_name}'):\n",
        "            dest = out_dir / src.name\n",
        "            if not dest.exists():\n",
        "                shutil.copy2(src, dest)\n",
        "\n",
        "print('Done. Final structure under:', base_proc)"
      ]
    }
  ],
